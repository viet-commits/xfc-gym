---
import Icon from '../components/Icon.astro';
import { gym, hours, telHref, mapsUrl } from '../data/gym';
---

<footer class="bg-[var(--bg-primary)] border-t border-white/[0.06] py-16 px-4">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
    <!-- Brand -->
    <div>
      <img src="/images/xfc-logo.png" alt={gym.name} class="h-10 w-auto mb-4" width="512" height="512" />
      <p class="font-inter text-[var(--text-muted)] text-sm leading-relaxed max-w-xs">
        Carrum Downs' premier MMA &amp; martial arts gym. Train harder. Fight smarter.
      </p>
      <!-- Social. 44px targets so they clear the minimum tap size on mobile. -->
      <div class="flex gap-3 mt-5">
        <a href={gym.facebook} target="_blank" rel="noopener" class="w-11 h-11 flex items-center justify-center rounded bg-[var(--bg-secondary)] text-[var(--text-muted)] hover:text-[var(--accent-primary)] hover:bg-[#2a2a2a] transition-colors" aria-label="XFC Carrum Downs on Facebook">
          <Icon size={20} name="brand-facebook" />
        </a>
        <a href={gym.instagram} target="_blank" rel="noopener" class="w-11 h-11 flex items-center justify-center rounded bg-[var(--bg-secondary)] text-[var(--text-muted)] hover:text-[var(--accent-primary)] hover:bg-[#2a2a2a] transition-colors" aria-label="XFC Carrum Downs on Instagram">
          <Icon size={20} name="brand-instagram" />
        </a>
        <a href={gym.youtube} target="_blank" rel="noopener" class="w-11 h-11 flex items-center justify-center rounded bg-[var(--bg-secondary)] text-[var(--text-muted)] hover:text-[var(--accent-primary)] hover:bg-[#2a2a2a] transition-colors" aria-label="XFC Carrum Downs on YouTube">
          <Icon size={20} name="brand-youtube" />
        </a>
      </div>
    </div>

    <!-- Contact -->
    <div>
      <h2 class="font-montserrat font-bold text-xs uppercase tracking-[0.12em] text-[var(--text-primary)] mb-5">Contact</h2>
      <ul class="space-y-1 font-inter text-sm text-[var(--text-muted)]">
        <li>
          <a href={mapsUrl} target="_blank" rel="noopener" class="flex items-start gap-2 py-2.5 hover:text-[var(--accent-primary)] transition-colors">
            <Icon name="map-pin" class="text-[var(--accent-primary)] mt-0.5 flex-shrink-0" />
            <span>{gym.street}<br />{gym.suburb} {gym.state} {gym.postcode}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${gym.email}`} class="flex items-center gap-2 py-2.5 hover:text-[var(--accent-primary)] transition-colors">
            <Icon name="mail" class="text-[var(--accent-primary)] flex-shrink-0" />
            <span>{gym.email}</span>
          </a>
        </li>
        <li>
          <a href={telHref} class="flex items-center gap-2 py-2.5 hover:text-[var(--accent-primary)] transition-colors">
            <Icon name="phone" class="text-[var(--accent-primary)] flex-shrink-0" />
            <span>{gym.phone}</span>
          </a>
        </li>
        <li>
          <a href={gym.instagram} target="_blank" rel="noopener" class="flex items-center gap-2 py-2.5 hover:text-[var(--accent-primary)] transition-colors">
            <Icon name="brand-instagram" class="text-[var(--accent-primary)] flex-shrink-0" />
            <span>{gym.instagramHandle}</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Hours -->
    <div>
      <h2 class="font-montserrat font-bold text-xs uppercase tracking-[0.12em] text-[var(--text-primary)] mb-5">Gym Hours</h2>
      <ul class="space-y-2 font-inter text-sm text-[var(--text-muted)]">
        {hours.map(h => (
          <li class="flex justify-between gap-4">
            <span class="font-medium text-[var(--text-primary)]">{h.day}</span>
            <span>{h.display}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto border-t border-white/[0.06] pt-8 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="font-inter text-xs text-white/55">Copyright {new Date().getFullYear()} {gym.name}. All rights reserved.</p>
    <a href="/privacy/" class="font-inter text-xs text-white/55 hover:text-[var(--accent-primary)] transition-colors inline-flex items-center min-h-[44px] px-1">Privacy Policy</a>
  </div>
</footer>
