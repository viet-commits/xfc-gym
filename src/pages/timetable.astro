---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { gym, telHref } from '../data/gym';

const days = [
  {
    day: "Monday",
    dayIndex: 1,
    hours: "4:30 PM - 8:30 PM",
    classes: [
      { time: "4:45 - 5:15 PM", name: "Junior MMA", detail: "Rising Warriors · Ages 7-9", cats: "junior" },
      { time: "5:15 - 6:00 PM", name: "Junior MMA", detail: "Elite Warriors · Ages 10-13", cats: "junior" },
      { time: "6:00 - 7:00 PM", name: "Kickboxing / Muay Thai", detail: "Advanced", cats: "kickboxing" },
      { time: "7:00 - 8:00 PM", name: "Kickboxing / Muay Thai", detail: "Beginner", cats: "kickboxing" },
    ]
  },
  {
    day: "Tuesday",
    dayIndex: 2,
    hours: "3:45 PM - 8:45 PM",
    classes: [
      { time: "4:00 - 4:30 PM", name: "Junior MMA", detail: "Little Warriors · Ages 2-4", cats: "junior" },
      { time: "4:40 - 5:10 PM", name: "Junior MMA", detail: "Junior Warriors · Ages 5-6", cats: "junior" },
      { time: "5:20 - 5:50 PM", name: "Junior MMA", detail: "Rising Warriors · Ages 7-9", cats: "junior" },
      { time: "6:00 - 6:40 PM", name: "Junior MMA", detail: "Elite Warriors · Ages 10-13", cats: "junior" },
      { time: "6:45 - 7:45 PM", name: "Mixed Martial Arts", detail: "All Levels", cats: "mma" },
      { time: "6:45 - 7:45 PM", name: "Boxing", detail: "All Levels", cats: "boxing" },
      { time: "7:45 - 8:45 PM", name: "Brazilian Jiu Jitsu", detail: "All Levels", cats: "bjj" },
    ]
  },
  {
    day: "Wednesday",
    dayIndex: 3,
    hours: "4:30 PM - 8:30 PM",
    classes: [
      { time: "4:45 - 5:15 PM", name: "Junior MMA", detail: "Rising Warriors · Ages 7-9", cats: "junior" },
      { time: "5:15 - 6:00 PM", name: "Junior MMA", detail: "Elite Warriors · Ages 10-13", cats: "junior" },
      { time: "6:00 - 7:00 PM", name: "Kickboxing / Muay Thai", detail: "Advanced", cats: "kickboxing" },
      { time: "6:00 - 7:00 PM", name: "Adults Intake", detail: "Entry Class · New Members", cats: "mma kickboxing" },
      { time: "7:00 - 8:00 PM", name: "Kickboxing / Muay Thai", detail: "Beginner", cats: "kickboxing" },
    ]
  },
  {
    day: "Thursday",
    dayIndex: 4,
    hours: "3:45 PM - 8:45 PM",
    classes: [
      { time: "4:00 - 4:30 PM", name: "Junior MMA", detail: "Little Warriors · Ages 2-4", cats: "junior" },
      { time: "4:40 - 5:10 PM", name: "Junior MMA", detail: "Junior Warriors · Ages 5-6", cats: "junior" },
      { time: "5:20 - 5:50 PM", name: "Junior MMA", detail: "Rising Warriors · Ages 7-9", cats: "junior" },
      { time: "6:00 - 6:40 PM", name: "Junior MMA", detail: "Elite Warriors · Ages 10-13", cats: "junior" },
      { time: "6:45 - 7:45 PM", name: "Mixed Martial Arts", detail: "All Levels", cats: "mma" },
      { time: "6:45 - 7:45 PM", name: "Boxing", detail: "All Levels", cats: "boxing" },
      { time: "7:45 - 8:45 PM", name: "Brazilian Jiu Jitsu", detail: "All Levels", cats: "bjj" },
    ]
  },
  {
    day: "Friday",
    dayIndex: 5,
    hours: "5:30 PM - 7:30 PM",
    classes: [
      { time: "5:45 - 6:30 PM", name: "Adults Sparring", detail: "All Levels", cats: "mma kickboxing boxing bjj" },
      { time: "6:30 - 7:30 PM", name: "Kickboxing / Boxing", detail: "All Levels", cats: "kickboxing boxing" },
    ]
  },
  {
    day: "Saturday",
    dayIndex: 6,
    hours: "9:15 AM - 11:00 AM",
    classes: [
      { time: "9:30 - 10:00 AM", name: "Junior MMA", detail: "Junior Warriors · Ages 5-6", cats: "junior" },
      { time: "10:00 - 10:30 AM", name: "Junior MMA", detail: "Rising Warriors · Ages 7-9", cats: "junior" },
      { time: "10:30 - 11:00 AM", name: "Junior MMA", detail: "Elite Warriors · Ages 10-13", cats: "junior" },
    ]
  },
];

---

<Layout title="Timetable" description="XFC Carrum Downs class timetable — MMA, Kickboxing, BJJ, Boxing for all ages and levels.">

  <!-- HERO -->
  <section class="py-24 md:py-32 px-4 text-center bg-[var(--bg-secondary)]">
    <div class="max-w-3xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-4">Weekly Schedule</p>
      <h1 class="font-bebas text-white text-5xl md:text-7xl uppercase tracking-wide mb-4">Class Timetable</h1>
      <p class="font-inter text-[var(--text-muted)] text-lg">XFC Carrum Downs · 31 Lathams Rd</p>
    </div>
  </section>

  <!-- FILTER BAR -->
  <section class="bg-[var(--bg-primary)] pt-12 pb-0 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap justify-center gap-2 mb-10 reveal">
        <button class="tt-filter-btn font-montserrat font-bold text-xs uppercase tracking-widest px-4 min-h-[44px] border border-[var(--accent-primary)] text-[var(--accent-primary)] bg-xfc-gold/10" data-filter="all" aria-pressed="true">All Classes</button>
        <button class="tt-filter-btn font-montserrat font-bold text-xs uppercase tracking-widest px-4 min-h-[44px] border border-white/10 text-[var(--text-muted)] hover:border-white/20 hover:text-white transition-all" data-filter="junior" aria-pressed="false">Junior MMA</button>
        <button class="tt-filter-btn font-montserrat font-bold text-xs uppercase tracking-widest px-4 min-h-[44px] border border-white/10 text-[var(--text-muted)] hover:border-white/20 hover:text-white transition-all" data-filter="kickboxing" aria-pressed="false">Kickboxing</button>
        <button class="tt-filter-btn font-montserrat font-bold text-xs uppercase tracking-widest px-4 min-h-[44px] border border-white/10 text-[var(--text-muted)] hover:border-white/20 hover:text-white transition-all" data-filter="mma" aria-pressed="false">MMA</button>
        <button class="tt-filter-btn font-montserrat font-bold text-xs uppercase tracking-widest px-4 min-h-[44px] border border-white/10 text-[var(--text-muted)] hover:border-white/20 hover:text-white transition-all" data-filter="bjj" aria-pressed="false">BJJ</button>
        <button class="tt-filter-btn font-montserrat font-bold text-xs uppercase tracking-widest px-4 min-h-[44px] border border-white/10 text-[var(--text-muted)] hover:border-white/20 hover:text-white transition-all" data-filter="boxing" aria-pressed="false">Boxing</button>
      </div>
    </div>
  </section>

  <!-- TIMETABLE -->
  <section class="bg-[var(--bg-primary)] py-8 px-4 pb-20">
    <div class="max-w-7xl mx-auto space-y-4">

      {days.map((d) => (
          <div
            class="tt-day border overflow-hidden transition-all duration-300 border-white/[0.06] bg-[var(--bg-secondary)]"
            data-day-index={String(d.dayIndex)}
          >
            {/* Day header */}
            <div class="tt-day-header flex items-center justify-between gap-2 px-4 sm:px-6 py-5 cursor-pointer md:cursor-default select-none bg-xfc-black/30 border-b border-white/[0.04]">
              <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <h2 class="font-bebas text-2xl md:text-3xl text-white uppercase tracking-wide">{d.day}</h2>
                <span class="tt-today-badge font-montserrat font-bold text-[0.625rem] sm:text-xs uppercase tracking-widest text-[var(--accent-primary)] bg-xfc-gold/10 px-2 sm:px-2.5 py-0.5 border border-xfc-gold/20 whitespace-nowrap" style="display:none">Today</span>
              </div>
              <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <span class="font-inter text-xs sm:text-sm text-[var(--text-muted)] whitespace-nowrap">{d.hours}</span>
                <Icon name="chevron-down" class="text-[var(--text-muted)] md:hidden tt-chevron transition-transform duration-200 shrink-0" />
              </div>
            </div>

            {/* Class rows */}
            <div class="tt-day-body divide-y divide-white/[0.03]">
              <p class="tt-empty hidden px-6 py-4 font-inter text-sm text-[var(--text-muted)]">No classes in this category on {d.day}.</p>
              {d.classes.map((c) => (
                <div
                  class="tt-class-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 px-6 py-4 border-l-white/[0.06]"
                  data-cats={c.cats}
                  style="border-left-width: 3px;"
                >
                  <div class="font-montserrat font-bold text-sm text-white w-44 shrink-0">{c.time}</div>
                  <div class="flex-1">
                    <span class="font-montserrat font-bold text-sm text-[var(--text-primary)] uppercase tracking-wide">{c.name}</span>
                    <span class="font-inter text-sm text-[var(--text-muted)] ml-2">{c.detail}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
      ))}

    </div>
  </section>

  <!-- CTA — the timetable is the highest-intent page on the site; it previously
       ended at the footer with no way to act on what the visitor had just read. -->
  <section class="bg-[var(--bg-secondary)] py-20 px-4 text-center border-t border-white/[0.04]">
    <div class="max-w-2xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-3">Found a class that fits?</p>
      <h2 class="font-bebas text-white text-3xl md:text-4xl uppercase tracking-wide mb-4">Start With a $39 Trial</h2>
      <p class="font-inter text-[var(--text-muted)] mb-8">Two weeks of unlimited training for $39. No experience needed, no gear required, no obligation after the trial.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/join/" class="btn-primary">$39 Trial <Icon name="arrow-right" /></a>
        <a href={telHref} class="btn-outline"><Icon name="phone" /> Call {gym.phone}</a>
      </div>
    </div>
  </section>

  <!-- TODAY BADGE + FILTER + ACCORDION JS -->
  <script>
    // ── Today badge (client-side so it updates daily) ──
    (function() {
      var today = new Date().getDay(); // 0=Sun 1=Mon … 6=Sat
      var todayIndex = today === 0 ? 0 : today; // Sunday → 0 (no badge, gym closed)
      if (todayIndex === 0) return;

      var todayDay = document.querySelector('.tt-day[data-day-index="' + todayIndex + '"]');
      if (!todayDay) return;

      // Activate border + bg
      todayDay.classList.remove('border-white/[0.06]', 'bg-[var(--bg-secondary)]');
      todayDay.classList.add('border-[var(--accent-primary)]', 'bg-xfc-gold/[0.03]');

      // Show badge
      var badge = todayDay.querySelector('.tt-today-badge');
      if (badge) (badge as HTMLElement).style.display = '';

      // Highlight class row borders
      todayDay.querySelectorAll('.tt-class-row').forEach(function(row) {
        row.classList.remove('border-l-white/[0.06]');
        row.classList.add('!border-l-[var(--accent-primary)]');
      });
    })();

    // ── Filter + Accordion ──
    const isMobile = () => window.innerWidth < 768;

    const setDayOpen = (day: Element, open: boolean) => {
      const body = day.querySelector<HTMLElement>('.tt-day-body');
      const chevron = day.querySelector<HTMLElement>('.tt-chevron');
      const header = day.querySelector<HTMLElement>('.tt-day-header');
      if (!body) return;
      body.style.display = open ? 'block' : 'none';
      if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
      header?.setAttribute('aria-expanded', String(open));
    };

    const applyFilter = (filter: string) => {
      document.querySelectorAll('.tt-day').forEach(day => {
        let visible = 0;
        day.querySelectorAll<HTMLElement>('.tt-class-row').forEach(row => {
          // Exact token match. `cats.includes('boxing')` also matched
          // "kickboxing", so the Boxing filter used to show Muay Thai classes.
          const cats = (row.getAttribute('data-cats') || '').split(/\s+/);
          const show = filter === 'all' || cats.includes(filter);
          row.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        // Empty-state instead of a bare day header with nothing under it
        const empty = day.querySelector<HTMLElement>('.tt-empty');
        if (empty) empty.classList.toggle('hidden', visible > 0);

        // On mobile, open any day that has matches so a filter never yields a
        // screen with nothing on it.
        if (isMobile() && filter !== 'all') setDayOpen(day, visible > 0);
      });
    };

    const selectFilter = (filter: string) => {
      const btn = document.querySelector<HTMLElement>(`.tt-filter-btn[data-filter="${filter}"]`);
      if (btn) btn.click();
    };

    document.querySelectorAll('.tt-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        document.querySelectorAll('.tt-filter-btn').forEach(b => {
          b.classList.remove('border-[var(--accent-primary)]', 'text-[var(--accent-primary)]', 'bg-xfc-gold/10');
          b.classList.add('border-white/10', 'text-[var(--text-muted)]');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.remove('border-white/10', 'text-[var(--text-muted)]');
        btn.classList.add('border-[var(--accent-primary)]', 'text-[var(--accent-primary)]', 'bg-xfc-gold/10');
        btn.setAttribute('aria-pressed', 'true');
        applyFilter(filter);
      });
    });

    // Deep link: /timetable/?filter=bjj arrives pre-filtered from a class card.
    {
      const wanted = new URLSearchParams(location.search).get('filter');
      const valid = [...document.querySelectorAll('.tt-filter-btn')].map(b => b.getAttribute('data-filter'));
      if (wanted && wanted !== 'all' && valid.includes(wanted)) selectFilter(wanted);
    }

    // Mobile accordion. Today starts open (falling back to the first day) so the
    // page never loads as six empty day names.
    if (isMobile()) {
      const days = [...document.querySelectorAll('.tt-day')];
      const todayIdx = new Date().getDay();
      const openByDefault = days.find(d => d.getAttribute('data-day-index') === String(todayIdx)) || days[0];

      days.forEach(day => {
        setDayOpen(day, day === openByDefault);
        const header = day.querySelector('.tt-day-header');
        if (!header) return;
        header.setAttribute('role', 'button');
        header.setAttribute('tabindex', '0');
        const toggle = () => {
          const body = day.querySelector<HTMLElement>('.tt-day-body');
          setDayOpen(day, !!body && body.style.display === 'none');
        };
        header.addEventListener('click', toggle);
        header.addEventListener('keydown', (e) => {
          const key = (e as KeyboardEvent).key;
          if (key === 'Enter' || key === ' ') { e.preventDefault(); toggle(); }
        });
      });
    }
  </script>

</Layout>
