---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const headCoach = {
  name: 'Haysem Abdallah',
  title: 'Head Coach &amp; Co-Founder',
  image: '/images/haysem-abdallah-c.jpg',
  bio: 'Haysem has competed at elite level in MMA and Boxing. A lifelong martial artist and co-founder of XFC Carrum Downs, he brings world-class coaching to every session. His philosophy is simple: technique over talent, discipline over motivation, and community over competition.',
  credentials: ['MMA & Boxing Coach', 'Co-Founder XFC', 'Competition Experience'],
};

const coaches = [
  {
    name: 'Jamie Abdallah',
    title: 'Muay Thai &amp; Kickboxing Coach',
    image: '/images/jamie-abdallah-c.jpg',
    bio: 'Jamie is a highly experienced Muay Thai fighter and instructor with numerous titles across Australia. His technical precision and competitive fire make him one of the best striking coaches in Melbourne.',
    credentials: ['Muay Thai & Kickboxing Coach', '15+ Years Experience', 'Competition Background'],
  },
  {
    name: 'Kelly Seif',
    title: 'Coach — MMA &amp; Kickboxing',
    image: '/images/kelly-seif-c.png',
    bio: 'Kelly brings high-level experience and coaching expertise to the XFC team. A dedicated instructor with a passion for developing athletes across MMA and kickboxing disciplines.',
    credentials: ['MMA & Kickboxing Coach', 'Competition Experience'],
  },
  {
    name: 'Joseph Haddad',
    title: 'Coach',
    image: '/images/joseph-haddad-c.png',
    bio: 'Joseph rounds out the XFC coaching team with comprehensive martial arts knowledge and a commitment to helping members of all levels achieve their goals.',
    credentials: ['Coach', 'All-Levels Instructor'],
  },
];
---

<Layout title="Coaches" description="Meet the XFC Carrum Downs coaching team — professional MMA, Muay Thai, and BJJ coaches.">

  <!-- PAGE HERO -->
  <section class="relative py-32 md:py-40 px-4 text-center overflow-hidden">
    <img
      src="/images/coaches-hero.jpg"
      alt="XFC coaching team"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1920" height="800" loading="eager" fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/85 z-[1]"></div>
    <div class="relative z-10 max-w-3xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-4">Meet Your Team</p>
      <h1 class="font-bebas text-white text-5xl md:text-7xl uppercase tracking-wide mb-4">
        Our <span style="color:var(--accent-primary)">Coaches</span>
      </h1>
      <p class="font-inter text-[var(--text-muted)] text-lg max-w-xl mx-auto">
        Competition-proven athletes and certified instructors dedicated to helping you reach your full potential.
      </p>
    </div>
  </section>

  <!-- HEAD COACH — editorial feature -->
  <section class="bg-[var(--bg-primary)] py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto reveal">
      <div class="flex flex-col md:flex-row border border-white/[0.06] overflow-hidden bg-[var(--bg-secondary)]">
        <div class="md:w-2/5 overflow-hidden">
          <img src={headCoach.image} alt={headCoach.name} class="w-full h-full object-cover object-top" style="min-height:400px;" width="600" height="750" loading="eager" />
        </div>
        <div class="md:w-3/5 p-8 md:p-12 flex flex-col justify-center">
          <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-2">Head Coach</p>
          <h2 class="font-bebas text-white text-4xl md:text-5xl uppercase tracking-wide mb-2">{headCoach.name}</h2>
          <p class="font-montserrat font-bold text-sm text-[var(--accent-primary)] uppercase tracking-widest mb-5">{headCoach.title}</p>
          <div class="flex flex-wrap gap-2 mb-5">
            {headCoach.credentials.map(c => (
              <span class="font-inter text-xs text-[var(--text-muted)] bg-white/[0.06] px-3 py-1 rounded-full border border-white/[0.06]">{c}</span>
            ))}
          </div>
          <p class="font-inter text-[var(--text-muted)] text-base leading-relaxed">{headCoach.bio}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COACHING TEAM GRID -->
  <section class="bg-[var(--bg-primary)] pb-24 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="reveal text-center mb-14">
        <h2 class="font-bebas text-white text-3xl md:text-4xl uppercase tracking-wide">The Coaching Team</h2>
        <div class="gold-sep mx-auto mt-3"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
        {coaches.map(coach => (
          <div class="bg-[var(--bg-secondary)] border border-white/[0.06] overflow-hidden group hover:border-[var(--accent-primary)]/20 transition-colors duration-300">
            {coach.image ? (
              <div class="aspect-[4/5] overflow-hidden">
                <img src={coach.image} alt={coach.name} class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500" width="400" height="500" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-[4/5] bg-[var(--bg-primary)] flex items-center justify-center">
                <Icon name="user" class="text-5xl text-white/10" />
              </div>
            )}
            <div class="p-6">
              <h3 class="font-montserrat font-bold text-lg text-white uppercase tracking-wide mb-1">{coach.name}</h3>
              <p class="font-inter text-xs text-[var(--accent-primary)] font-medium uppercase tracking-widest mb-3">{coach.title}</p>
              <div class="flex flex-wrap gap-1.5 mb-3">
                {coach.credentials.map(c => (
                  <span class="font-inter text-xs text-[var(--text-muted)] bg-white/[0.06] px-2.5 py-0.5 rounded-full border border-white/[0.06]">{c}</span>
                ))}
              </div>
              <p class="font-inter text-sm text-[var(--text-muted)] leading-relaxed">{coach.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--bg-secondary)] py-24 px-4 text-center border-t border-white/[0.04]">
    <div class="max-w-2xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-3">Ready to Train?</p>
      <h2 class="font-bebas text-white text-3xl md:text-4xl uppercase tracking-wide mb-4">Train With Our Team</h2>
      <p class="font-inter text-[var(--text-muted)] mb-8">Experience first-hand what our coaches can do for you. Start your $39 two-week trial today.</p>
      <a href="/join" class="btn-primary">$39 Trial <Icon name="arrow-right" /></a>
    </div>
  </section>

</Layout>
