---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Bios supplied by the business, 30 Jul 2026. All four coaches carry the
// Head Coach title, so the page presents them with equal billing (the old
// layout featured one coach above the rest).
const coaches = [
  {
    name: 'Jamie Abdallah',
    title: 'Head Coach',
    image: '/images/jamie-abdallah-c.jpg',
    bio: 'With a lifelong passion for martial arts, Jamie\u2019s foundation is in MMA, while his love extends across all martial arts disciplines. Having coached athletes from complete beginners through to world champions in kickboxing, he is passionate about helping every student reach their potential. Jamie believes martial arts is about far more than competition \u2014 it\u2019s about building confidence, discipline, resilience, and creating a positive environment where every member can succeed.',
    credentials: ['MMA & All Disciplines', 'Coached World Champions'],
  },
  {
    name: 'Haysem Abdallah',
    title: 'Head Coach',
    image: '/images/haysem-abdallah-c.jpg',
    bio: 'Haysem is passionate about helping students build confidence, develop strong fundamentals, and enjoy their martial arts journey. His supportive coaching style ensures every member, regardless of age or experience, feels welcomed, challenged, and encouraged to improve each time they step onto the mats. He believes consistency, hard work, and a positive attitude are the keys to long-term success.',
    credentials: ['All Ages & Levels', 'Fundamentals First'],
  },
  {
    name: 'Joey Haddad',
    title: 'Head Coach',
    image: '/images/joseph-haddad-c.png',
    bio: 'Joey is an all-round martial artist with experience across multiple disciplines and a passion for developing well-rounded athletes. His coaching focuses on building strong fundamentals while helping students progress technically, physically, and mentally. Whether working with beginners or experienced competitors, Joey creates an environment where members are challenged, supported, and motivated to continually improve.',
    credentials: ['Multi-Discipline', 'Beginners to Competitors'],
  },
  {
    name: 'Kelly Seif',
    title: 'Head Coach',
    image: '/images/kelly-seif-c.png',
    bio: 'With over 30 years in the martial arts industry, Kelly brings a wealth of knowledge and experience to XFC. Her passion for coaching, mentoring, and developing students has helped shape countless martial artists over the years. Kelly is dedicated to creating a welcoming environment where members of all ages can grow in confidence, develop lifelong skills, and enjoy their martial arts journey.',
    credentials: ['30+ Years in Martial Arts', 'Coach & Mentor'],
  },
];
---

<Layout title="Coaches" navOverlay description="Meet the XFC Carrum Downs coaching team — professional MMA, Muay Thai, and BJJ coaches.">

  <!-- PAGE HERO -->
  <section class="relative py-32 md:py-40 px-4 text-center overflow-hidden">
    <img
      src="/images/coaches-hero.jpg"
      alt="XFC coaching team"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1920" height="800" loading="eager" fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/85 z-[1]"></div>
    <div class="relative z-10 max-w-3xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-4">Meet Your Team</p>
      <h1 class="font-bebas text-white text-5xl md:text-7xl uppercase tracking-wide mb-4">
        Our <span style="color:var(--accent-primary)">Coaches</span>
      </h1>
      <p class="font-inter text-[var(--text-muted)] text-lg max-w-xl mx-auto">
        Competition-proven athletes and certified instructors dedicated to helping you reach your full potential.
      </p>
    </div>
  </section>

  <!-- COACHING TEAM GRID -->
  <section class="bg-[var(--bg-primary)] py-16 md:py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="reveal text-center mb-14">
        <h2 class="font-bebas text-white text-3xl md:text-4xl uppercase tracking-wide">The Coaching Team</h2>
        <div class="gold-sep mx-auto mt-3"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal-stagger">
        {coaches.map(coach => (
          <div class="bg-[var(--bg-secondary)] border border-white/[0.06] overflow-hidden group hover:border-xfc-gold/20 transition-colors duration-300">
            {coach.image ? (
              <div class="aspect-[4/5] overflow-hidden">
                <img src={coach.image} alt={coach.name} class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500" width="400" height="500" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-[4/5] bg-[var(--bg-primary)] flex items-center justify-center">
                <Icon size={48} name="user" class="text-white/10" />
              </div>
            )}
            <div class="p-6">
              <h3 class="font-montserrat font-bold text-lg text-white uppercase tracking-wide mb-1">{coach.name}</h3>
              <p class="font-inter text-xs text-[var(--accent-primary)] font-medium uppercase tracking-widest mb-3">{coach.title}</p>
              <div class="flex flex-wrap gap-1.5 mb-3">
                {coach.credentials.map(c => (
                  <span class="font-inter text-xs text-white/85 bg-white/[0.06] px-2.5 py-0.5 rounded-full border border-white/[0.06]">{c}</span>
                ))}
              </div>
              <p class="font-inter text-sm text-[var(--text-muted)] leading-relaxed">{coach.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--bg-secondary)] py-24 px-4 text-center border-t border-white/[0.04]">
    <div class="max-w-2xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-3">Ready to Train?</p>
      <h2 class="font-bebas text-white text-3xl md:text-4xl uppercase tracking-wide mb-4">Train With Our Team</h2>
      <p class="font-inter text-[var(--text-muted)] mb-8">Experience first-hand what our coaches can do for you. Start your $39 two-week trial today.</p>
      <a href="/join/" class="btn-primary">$39 Trial <Icon name="arrow-right" /></a>
    </div>
  </section>

</Layout>
