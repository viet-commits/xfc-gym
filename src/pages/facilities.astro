---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

/**
 * Facility tour.
 *
 * Rebuilt for three reasons:
 *  1. The old list showed the same photo twice — `wp-603801…jpg` and `facility-4.jpg`
 *     are byte-identical, as are several other `wp-*` / `gym-*` / `facility-*` aliases.
 *  2. Most alt text described the wrong thing: "Strength & Conditioning" was the boxing
 *     ring, and three "training session" labels were photographs of empty rooms.
 *  3. Four entries were portrait or tiny (one was 257x325) inside a 500x384 landscape
 *     window, so they were cropped to nothing.
 *
 * Every entry below is a distinct file, landscape, and described as what it shows.
 */
const facilityImages = [
  { src: '/images/facility-4.jpg', alt: 'Strength and conditioning area with squat racks and free weights' },
  { src: '/images/xfc-ring.jpg', alt: 'Full-size MMA cage with matted floor' },
  { src: '/images/facility-1.jpg', alt: 'The XFC boxing ring' },
  { src: '/images/facility-3.jpg', alt: 'Medicine balls, pads and striking equipment on storage racks' },
  { src: '/images/facility-2.jpg', alt: 'MMA cage beside the main matted training floor' },
  { src: '/images/gym-4.jpg', alt: 'Conditioning equipment including bikes, kettlebells and weights' },
  { src: '/images/facility-6.jpg', alt: 'Open matted training floor with wall-mounted pads' },
  { src: '/images/wp-936535_447461578669518_1329619288_n.jpg', alt: 'Matted grappling area with wall padding' },
  { src: '/images/wp-21279_447461692002840_1790360625_n-768x512-1.jpg', alt: 'Row of heavy bags beside the cage' },
  { src: '/images/facility-5.jpg', alt: 'XFC members and coaches together on the mats' },
  { src: '/images/become-champion.jpg', alt: 'XFC fighters holding championship belts' },
  { src: '/images/instagram/09.jpg', alt: 'Two members drilling on the matted floor' },
];

const features = [
  { icon: 'shield', title: 'MMA Cage & Training Area', desc: 'Train and spar in our full-size MMA cage. We also have a boxing area, heavy bags, matted grappling space and strength/conditioning equipment.' },
  { icon: 'bolt', title: 'Strength & Conditioning', desc: 'Dedicated S&C area with free weights, kettlebells, resistance bands, and conditioning equipment.' },
  { icon: 'layout-grid', title: 'Dedicated Mat Space', desc: 'Extensive matted floor area for BJJ, wrestling, and grappling training — clean, maintained, and safe.' },
  { icon: 'circle-dot', title: 'Heavy Bag Station', desc: 'A full row of heavy bags, Thai pads, and speed bags for solo and partner striking work.' },
  { icon: 'home', title: 'Modern Changerooms', desc: 'Clean, well-maintained changerooms with showers — so you can come straight from work and train.' },
  { icon: 'car', title: 'Free Parking', desc: 'Easy access from Lathams Road with free on-site parking for all members and guests.' },
];
---

<Layout title="Facilities" description="Tour XFC Carrum Downs — our state-of-the-art MMA gym with MMA cage, mat space, and full S&C area.">

  <!-- HERO -->
  <section class="py-24 md:py-32 px-4 text-center bg-[var(--bg-secondary)]">
    <div class="max-w-3xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-4">Purpose-Built for Champions</p>
      <h1 class="font-bebas text-white text-5xl md:text-7xl uppercase tracking-wide mb-4">
        Our <span style="color:var(--accent-primary)">Facilities</span>
      </h1>
      <p class="font-inter text-[var(--text-muted)] text-lg max-w-xl mx-auto">
        State-of-the-art equipment and a purpose-built training environment — everything you need to train at your best.
      </p>
    </div>
  </section>

  <!-- HORIZONTAL SCROLL PHOTO STRIP -->
  <section class="bg-[var(--bg-primary)] py-16 px-4">
    <div class="reveal">
      <div class="scroll-strip" id="facility-strip" tabindex="0" role="region" aria-label="Facility photos — scroll horizontally">
        {facilityImages.map((img) => (
          <div class="w-[85vw] md:w-[500px] overflow-hidden bg-[var(--bg-secondary)] flex-shrink-0 group">
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-72 md:h-96 object-cover group-hover:scale-[1.03] transition-transform duration-500"
              width="500" height="400" loading="lazy"
            />
          </div>
        ))}
      </div>
      <div class="flex justify-center items-center gap-3 mt-5">
        <button class="strip-arrow" id="strip-prev" type="button" aria-label="Previous facility photos">
          <Icon name="chevron-left" />
        </button>
        <p class="font-inter text-white/70 text-xs">Scroll to tour our facilities</p>
        <button class="strip-arrow" id="strip-next" type="button" aria-label="More facility photos">
          <Icon name="chevron-right" />
        </button>
      </div>

      <style>
        .strip-arrow {
          width: 44px; height: 44px;
          display: flex; align-items: center; justify-content: center;
          border: 1.5px solid var(--accent-primary);
          background: transparent; color: var(--accent-primary);
          border-radius: 3px; cursor: pointer;
          transition: background 0.2s ease, color 0.2s ease;
        }
        .strip-arrow:hover { background: var(--accent-primary); color: #000; }
        .strip-arrow[disabled] { opacity: 0.35; cursor: default; }
        .strip-arrow[disabled]:hover { background: transparent; color: var(--accent-primary); }
        #facility-strip:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 4px; }
      </style>

      <script>
        (function () {
          const strip = document.getElementById('facility-strip');
          const prev = document.getElementById('strip-prev');
          const next = document.getElementById('strip-next');
          if (!strip || !prev || !next) return;

          const step = () => {
            const first = strip.querySelector('div');
            return first ? first.getBoundingClientRect().width + 16 : 400;
          };
          const sync = () => {
            prev.toggleAttribute('disabled', strip.scrollLeft <= 4);
            next.toggleAttribute('disabled', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4);
          };
          prev.addEventListener('click', () => strip.scrollBy({ left: -step(), behavior: 'smooth' }));
          next.addEventListener('click', () => strip.scrollBy({ left: step(), behavior: 'smooth' }));
          strip.addEventListener('scroll', sync, { passive: true });
          strip.addEventListener('keydown', (e) => {
            const k = e.key;
            if (k === 'ArrowRight') { e.preventDefault(); strip.scrollBy({ left: step(), behavior: 'smooth' }); }
            if (k === 'ArrowLeft')  { e.preventDefault(); strip.scrollBy({ left: -step(), behavior: 'smooth' }); }
          });
          sync();
          window.addEventListener('resize', sync);
        })();
      </script>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="bg-[var(--bg-secondary)] py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="reveal text-center mb-14">
        <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-3">Everything Under One Roof</p>
        <h2 class="font-bebas text-white text-4xl md:text-5xl uppercase tracking-wide mb-4">World-Class Training Environment</h2>
        <p class="font-inter text-[var(--text-muted)] max-w-xl mx-auto">Designed for serious athletes and passionate beginners alike.</p>
        <div class="gold-sep mx-auto mt-4"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
        {features.map(feature => (
          <div class="flex gap-5 items-start p-8 bg-[var(--bg-primary)] border border-white/[0.06] hover:border-xfc-gold/20 transition-colors duration-300">
            <div class="w-14 h-14 flex items-center justify-center flex-shrink-0 bg-xfc-gold/10 text-[var(--accent-primary)] rounded-sm">
              <Icon name={feature.icon} size={24} />
            </div>
            <div>
              <h3 class="font-montserrat font-bold text-base text-white uppercase tracking-wide mb-2">{feature.title}</h3>
              <p class="font-inter text-sm text-[var(--text-muted)] leading-relaxed">{feature.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCATION + MAP -->
  <section class="bg-[var(--bg-primary)] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto reveal">
      <p class="font-inter text-[var(--accent-primary)] text-xs uppercase tracking-[0.2em] font-medium mb-3">Come Visit Us</p>
      <h2 class="font-bebas text-white text-4xl uppercase tracking-wide mb-8">Find Us</h2>

      <div class="bg-[var(--bg-secondary)] border border-white/[0.06] p-8 mb-8 text-center">
        <div class="flex items-center justify-center gap-3 mb-4">
          <Icon size={24} name="map-pin" class="text-[var(--accent-primary)]" />
          <div>
            <p class="font-montserrat font-bold text-lg text-white uppercase tracking-wide">31 Lathams Road</p>
            <p class="font-montserrat font-bold text-lg text-white uppercase tracking-wide">Carrum Downs VIC 3201</p>
          </div>
        </div>
        <p class="font-inter text-sm text-[var(--text-muted)] mb-4">Easy access from Lathams Road · Free on-site parking</p>
        <a href="https://maps.google.com/?q=31+Lathams+Rd+Carrum+Downs+VIC+3201" target="_blank" rel="noopener" class="inline-flex items-center gap-1 min-h-[44px] font-inter text-sm text-[var(--accent-primary)] hover:underline">
          Get Directions <Icon name="arrow-right" />
        </a>

        <div style="overflow:hidden;margin-top:1.5rem;aspect-ratio:16/9;">
          {/* Address-query embed: resolves by address, needs no API key and no place ID.
              The previous URL used a hand-built `pb=` payload with an invalid place ID
              and rendered as a blank grey box. */}
          <iframe
            title="Map of XFC Carrum Downs, 31 Lathams Road, Carrum Downs VIC 3201"
            src="https://maps.google.com/maps?q=31%20Lathams%20Road%2C%20Carrum%20Downs%20VIC%203201&z=15&output=embed"
            width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>

      <a href="/join/" class="btn-primary">$39 Trial <Icon name="arrow-right" /></a>
    </div>
  </section>

</Layout>
