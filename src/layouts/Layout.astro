---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * Set on pages with a full-bleed hero that should sit *under* the transparent
   * fixed nav. Leaving it false offsets <main> so content clears the nav instead.
   */
  navOverlay?: boolean;
}

const { title, description = 'XFC Carrum Downs — Premier MMA & Martial Arts Gym', ogImage = 'https://xfcgym.com.au/images/instagram/fighter-stance-cage.jpg', navOverlay = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://xfcgym.com.au').href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preload" as="image" href="/images/instagram/fighter-stance-cage.webp" fetchpriority="high">
    <link rel="canonical" href={canonicalUrl}>

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | XFC Carrum Downs`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={`${title} | XFC Carrum Downs`}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <title>{title} | XFC Carrum Downs</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Self-Hosted Fonts -->
    <style>
      @font-face{font-family:'Bebas Neue';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/bebas-neue-400.woff2') format('woff2')}
      @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2')}
      @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2')}
      @font-face{font-family:'Montserrat';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/montserrat-700.woff2') format('woff2')}
      @media(max-width:768px){[style*="grid-template-columns"]{grid-template-columns:1fr!important}.no-wrap-mobile{flex-wrap:nowrap!important}}
    </style>

    <!-- Schema.org: LocalBusiness + AggregateRating -->
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"SportsActivityLocation","name":"XFC Carrum Downs","description":"Premier MMA and martial arts gym in Carrum Downs. Classes in MMA, kickboxing, BJJ, boxing, and kids programs for all levels.","url":"https://xfcgym.com.au","telephone":"+61397708401","address":{"@type":"PostalAddress","streetAddress":"31 Lathams Road","addressLocality":"Carrum Downs","addressRegion":"VIC","postalCode":"3201","addressCountry":"AU"},"geo":{"@type":"GeoCoordinates","latitude":-38.0885,"longitude":145.1748},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday"],"opens":"16:30","closes":"20:45"},{"@type":"OpeningHoursSpecification","dayOfWeek":["Tuesday"],"opens":"15:45","closes":"20:45"},{"@type":"OpeningHoursSpecification","dayOfWeek":["Wednesday"],"opens":"16:30","closes":"20:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":["Thursday"],"opens":"15:45","closes":"20:45"},{"@type":"OpeningHoursSpecification","dayOfWeek":["Friday"],"opens":"15:45","closes":"19:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":["Saturday"],"opens":"09:00","closes":"11:00"}],"image":"/images/instagram/fighter-stance-cage.jpg","priceRange":"$$","sameAs":["https://www.instagram.com/xfc3201/","https://www.facebook.com/XFCCarrumDowns"]}
    </script>
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"AggregateRating","ratingValue":"5.0","reviewCount":"47","bestRating":"5","itemReviewed":{"@type":"SportsActivityLocation","name":"XFC Carrum Downs"}}
    </script>

    <style is:global>
      :root {
        --bg-primary: #0D0D0D;
        --bg-secondary: #1C1C1C;
        --accent-primary: #B8962E;
        --accent-light: #FDF6E3;
        --text-primary: #FFFFFF;
        --text-muted: #AAAAAA;
        --scroll: 0;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { background: var(--bg-primary); color: var(--text-primary); }
      img { max-width: 100%; height: auto; display: block; }

      body {
        font-family: 'Inter', sans-serif;
        font-weight: 400;
        background: var(--bg-primary);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        max-width: 100vw;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      main { flex: 1; }

      /* The nav is position:fixed, so it takes no layout space. Pages without a
         full-bleed hero offset <main> to clear it; pages with one let the hero
         run underneath the transparent nav (which is the whole point of it). */
      main.nav-offset { padding-top: 88px; }

      /* === BUTTONS === */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--accent-primary);
        color: var(--bg-primary);
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 1rem 2.25rem;
        border: none;
        border-radius: 2px;
        cursor: pointer;
        transition: all 300ms ease;
        min-height: 48px;
      }
      .btn-primary:hover {
        background: #c9a538;
        transform: translateY(-1px);
        box-shadow: 0 8px 32px rgba(184, 150, 46, 0.3);
      }

      .btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border: 1.5px solid rgba(255,255,255,0.3);
        color: var(--text-primary);
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 1rem 2.25rem;
        background: transparent;
        border-radius: 2px;
        cursor: pointer;
        transition: all 300ms ease;
        min-height: 48px;
      }
      .btn-outline:hover {
        border-color: var(--accent-primary);
        color: var(--accent-primary);
        transform: translateY(-1px);
      }

      /* === SCROLL REVEAL === */
      .reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.7s ease-out, transform 0.7s ease-out;
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Stagger children.
         Every child must be restored to opacity 1 — the per-child rules below only add
         the staggered delay. Restoring opacity per nth-child silently hides any child
         beyond the last rule, so the blanket rule comes first and is never omitted. */
      .reveal-stagger > * {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
      }
      .reveal-stagger.visible > * {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 700ms;
      }
      .reveal-stagger.visible > *:nth-child(1) { transition-delay: 0ms; }
      .reveal-stagger.visible > *:nth-child(2) { transition-delay: 100ms; }
      .reveal-stagger.visible > *:nth-child(3) { transition-delay: 200ms; }
      .reveal-stagger.visible > *:nth-child(4) { transition-delay: 300ms; }
      .reveal-stagger.visible > *:nth-child(5) { transition-delay: 400ms; }
      .reveal-stagger.visible > *:nth-child(6) { transition-delay: 500ms; }
      .reveal-stagger.visible > *:nth-child(7) { transition-delay: 600ms; }

      /* === GOLD SEPARATOR === */
      .gold-sep {
        display: block;
        width: 64px;
        height: 3px;
        background: var(--accent-primary);
      }

      /* === MARQUEE === */
      .marquee-track {
        display: flex;
        gap: 2rem;
        animation: marquee 40s linear infinite;
        width: max-content;
      }
      .marquee-track:hover { animation-play-state: paused; }
      @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      /* === HORIZONTAL SCROLL === */
      .scroll-strip {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 1rem;
        padding-bottom: 0.5rem;
      }
      .scroll-strip::-webkit-scrollbar { height: 3px; }
      .scroll-strip::-webkit-scrollbar-track { background: transparent; }
      .scroll-strip::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 4px; }
      .scroll-strip > * {
        scroll-snap-align: start;
        flex-shrink: 0;
      }

      /* === PREFERS REDUCED MOTION === */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        .reveal, .reveal-stagger > * {
          opacity: 1 !important;
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <Nav overlay={navOverlay} />
    <main class={navOverlay ? undefined : 'nav-offset'}>
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll reveal observer
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
